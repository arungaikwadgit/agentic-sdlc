# =============================================================================
# Agentic SDLC - Environment Variables
# Copy this file to .env (in the project root) and fill in your values.
# NEVER commit .env to git - it's already in .gitignore.
# =============================================================================

# - Supabase -----------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
#
# The app supports separate local/dev and production Supabase backends.
# Server-side APIs (`server/`) prefer *_LOCAL in non-production and
# *_PRODUCTION in production, then fall back to the generic keys below.

# Generic/shared values (safe defaults if you only have one Supabase project)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Optional local/dev-only server-side Supabase target
SUPABASE_URL_LOCAL=
SUPABASE_SERVICE_KEY_LOCAL=

# Optional production-only server-side Supabase target
SUPABASE_URL_PRODUCTION=
SUPABASE_SERVICE_KEY_PRODUCTION=

# - AI API Keys ---------------------------------------------------------------
# These are server-only - the frontend never sees them.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# - Backend Server ------------------------------------------------------------
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# - Frontend -----------------------------------------------------------------
VITE_API_URL=http://localhost:3001
NODE_ENV=development
