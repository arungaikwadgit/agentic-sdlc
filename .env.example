# =============================================================================
# Agentic SDLC — Environment Variables
# Copy this file to .env (in the project root) and fill in your values.
# NEVER commit .env to git — it's already in .gitignore.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project's public URL (looks like https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key — KEEP THIS SECRET, backend only
# This key bypasses Row Level Security — never put it in the frontend
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Anon/public key — safe for frontend (used with RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The same URL but as a VITE_ variable so the frontend can reach Supabase Auth
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# ── AI API Keys ───────────────────────────────────────────────────────────────
# These are server-only — the frontend never sees them.
# The Express server proxies all AI calls through /api/agents

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (optional — used if provider=anthropic in agent calls)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Backend Server ────────────────────────────────────────────────────────────
# Port the Express server listens on (Railway sets this automatically)
PORT=3001

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of your deployed backend API server (Express on Railway)
# For local dev, leave as http://localhost:3001
VITE_API_URL=http://localhost:3001

# Node environment
NODE_ENV=development
