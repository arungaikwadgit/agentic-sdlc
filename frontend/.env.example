# Frontend public environment variables
# Only values prefixed with VITE_ are exposed to the browser bundle.

# Primary backend API - proxy / gateway service
VITE_API_URL=http://localhost:3001

# Agent runtime API
VITE_RUNTIME_URL=http://localhost:4000

# Supabase browser auth configuration
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# L3 runtime tuning
VITE_L3_ITER_DELAY_MS=1500
