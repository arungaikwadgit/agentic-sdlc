# ─── Vite / Frontend ─────────────────────────────────────────────────────────
# All public env vars must be prefixed VITE_ to be exposed to the browser

# Primary backend API — LLM proxy (backend/proxy.js on Railway)
# Production: https://YOUR-PROXY-SERVICE.up.railway.app
VITE_API_URL=http://localhost:3001

# Agent runtime URL (backend/index.ts on Railway)
# Production: https://YOUR-RUNTIME-SERVICE.up.railway.app
VITE_RUNTIME_URL=http://localhost:4000

# Shared token used for admin-mode/server-to-server calls to the proxy
# Must match PROXY_TOKEN on Railway
VITE_PROXY_TOKEN=

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Get these from Supabase → Settings → API after creating a project
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─── LLM Provider Keys (client-side, optional) ───────────────────────────────
# Used only when the frontend makes direct LLM calls (e.g. L3 streaming).
# Leave blank to rely on server-side keys in proxy.js only.
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# ─── Admin bypass credentials ─────────────────────────────────────────────────
# Unlock admin mode: bypasses Supabase Auth, uses IndexedDB for project storage.
#
# SECURITY: In production, ALWAYS set strong values here. The defaults
# ("admin@local" / "admin") are baked into the public JS bundle if unset.
# Set these in Vercel → Project Settings → Environment Variables → Production.
VITE_ADMIN_EMAIL=admin@local
VITE_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ─── L3 runtime tuning ────────────────────────────────────────────────────────
# Inter-iteration delay (ms) for the L3 plan/act/observe loop.
# Increase if hitting TPM rate limits; decrease in dev for faster iteration.
# Default: 1500
VITE_L3_ITER_DELAY_MS=1500
