# ─── Vite / Frontend ─────────────────────────────────────────────────────────
# All public env vars must be prefixed VITE_ to be exposed to the browser

# Backend runtime URL (the Express server)
VITE_RUNTIME_URL=http://localhost:4000

# Legacy proxy JS server URL (existing agentic-sdlc proxy)
VITE_API_URL=http://localhost:3001

# ─── LLM Provider Keys (client-side, optional) ───────────────────────────────
# These are passed through the existing frontend → proxy flow.
# Leave blank if using server-side keys only.
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
