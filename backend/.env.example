# ─── Database ───────────────────────────────────────────────────────────────
# Keep local and production settings separate so they never overlap.
# Local development uses POSTGRES_URL_LOCAL.
POSTGRES_URL_LOCAL=postgresql://agentuser:agentpass@localhost:5432/agentdb

# Production deployment uses POSTGRES_URL_PRODUCTION.
POSTGRES_URL_PRODUCTION=

# Legacy fallback (kept for compatibility; local/prod should prefer the vars above)
POSTGRES_URL=

# Test database (isolated schema; used by migrate:up:test and jest)
POSTGRES_URL_TEST=postgresql://postgres:postgres@localhost:5432/agentic_sdlc_test

# ─── Runtime Server ──────────────────────────────────────────────────────────
RUNTIME_PORT=4000

# Required. Shared-secret token for /api/v1/agent-runs and /api/v1/agent-jobs.
# Callers must send it as the `x-api-token` header. The server refuses all
# requests to those routes with a 500 if this is unset — there is no
# "auth disabled" fallback. Generate a long random value per deployment,
# e.g.: openssl rand -hex 32
RUNTIME_API_TOKEN=

# Runtime service: durable lifecycle worker calls the proxy with this URL/token.
PROXY_API_URL=http://localhost:3001
PROXY_TOKEN=
BACKGROUND_WORKER_ENABLED=true
# Optional; zero disables scheduled reviews. Enable only after spend approval.
BACKGROUND_SCHEDULED_REVIEW_HOURS=0

# Proxy service: authenticated bridge target for lifecycle event enqueueing.
RUNTIME_API_URL=http://localhost:4000

# NODE_ENV: development | test | production
NODE_ENV=development

# ─── LLM Providers ──────────────────────────────────────────────────────────
# At least one provider key is required for agent runs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── Memory / Domain ─────────────────────────────────────────────────────────
# Default domain ID for domain_shared memory records (set per deployment)
DEFAULT_DOMAIN_ID=

# ─── Worker ──────────────────────────────────────────────────────────────────
# Poll interval in milliseconds for the durable job worker
WORKER_POLL_INTERVAL_MS=2000

# Test-only: override retry backoff so tests don't wait 30s
# TEST_RETRY_DELAY_MS=100

# ─── Supabase (backend/src/proxy.js) ────────────────────────────────────────
# Required for Supabase-JWT auth and for the invite/team/password flow
# (account provisioning, sign-in verification). Without these, checkToken()
# falls back to PROXY_TOKEN / admin-bypass-only auth and invite send will fail.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role key — required for provisionInviteeAccount() to create/reset
# invitee accounts and for scripts/cleanupInviteTestUsers.js. Keep secret;
# never send to the frontend.
SUPABASE_SERVICE_KEY=

# Comma-separated list of app-admin emails (checked case-insensitively).
# ADMIN_EMAIL and VITE_ADMIN_EMAIL are also merged in for compatibility.
ADMIN_EMAIL_ALLOWLIST=

# Base URL used to build invite links sent by email.
APP_URL=http://localhost:5173

# ─── Invite emails (backend/src/proxy.js — POST /api/invite/send) ──────────
# Preferred: Resend (HTTPS API — works on any Railway plan). Get a free API
# key at https://resend.com. Without a verified domain, leave RESEND_FROM_EMAIL
# unset to use Resend's shared "onboarding@resend.dev" sending address, which
# works for any recipient.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Fallback: Gmail SMTP. NOTE — Railway blocks outbound SMTP (ports 465/587)
# on Free/Trial/Hobby plans; this only works if this service is on Railway
# Pro or above. Prefer RESEND_API_KEY above unless you're already on Pro+.
# GMAIL_APP_PASSWORD is a 16-character Google App Password (not your account
# password) — generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the account).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# If neither RESEND_API_KEY nor GMAIL_USER/GMAIL_APP_PASSWORD is set, invite
# emails aren't sent — the invite link is still generated and shown in the
# UI for the admin to copy/share manually ("dev mode").

# Optional backend-only web research provider for agentic chat
TAVILY_API_KEY=
